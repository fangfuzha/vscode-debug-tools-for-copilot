{
  "name": "vscode-debug-tools-for-copilot",
  "displayName": "%displayName%",
  "version": "0.3.0",
  "description": "%description%",
  "publisher": "fangfuzha",
  "repository": {
    "type": "git",
    "url": "https://github.com/fangfuzha/vscode-debug-tools-for-copilot.git"
  },
  "license": "MIT",
  "files": [
    "out/**",
    "src/lm/skills/**",
    "l10n/**",
    "icon.png",
    "package.nls*.json",
    "README*.md",
    "LICENSE.md"
  ],
  "keywords": [
    "调试",
    "debug",
    "Copilot",
    "agent"
  ],
  "engines": {
    "vscode": "^1.144.0"
  },
  "l10n": "./l10n",
  "activationEvents": [
    "onDebug",
    "onStartupFinished"
  ],
  "categories": [
    "AI",
    "Chat",
    "Debuggers"
  ],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "debugtools.add-mcp-to-agent",
        "title": "%debugtools.add-mcp-to-agent%",
        "category": "%VS Code Debug Tools%"
      },
      {
        "command": "debugtools.show-mcp-diagnostics",
        "title": "%debugtools.show-mcp-diagnostics%",
        "category": "%VS Code Debug Tools%"
      },
      {
        "command": "debugtools.export-mcp-configuration",
        "title": "%debugtools.export-mcp-configuration%",
        "category": "%VS Code Debug Tools%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "debugtools.add-mcp-to-agent",
          "when": "true"
        },
        {
          "command": "debugtools.show-mcp-diagnostics",
          "when": "true"
        },
        {
          "command": "debugtools.export-mcp-configuration",
          "when": "true"
        }
      ]
    },
    "chatSkills": [
      {
        "path": "./src/lm/skills/vscode-debug-tools-guide/SKILL.md"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "fangfuzha.vscode-debug-tools-for-copilot",
        "label": "%mcp.debugToolsProvider.label%"
      }
    ]
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node20 --outfile=out/extension.js --external:vscode --minify",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && npm run lint",
    "lint": "eslint src scripts",
    "l10n": "vscode-l10n-dev export --outDir ./l10n src && node -e \"const fs=require('fs');const p='l10n/bundle.l10n.json';if(process.platform==='win32'){const s=fs.readFileSync(p,'utf8').replace(/\\r/g,'').split(String.fromCharCode(10)).join(String.fromCharCode(13,10));fs.writeFileSync(p,s,'utf8')}\"",
    "l10n:check": "node scripts/l10n-check.js",
    "l10n:xlf": "node -e \"require('fs').mkdirSync('l10n-xlf',{recursive:true})\" && vscode-l10n-dev generate-xlf --outFile ./l10n-xlf/bundle.l10n.xlf ./l10n/bundle.l10n.json",
    "l10n:import": "vscode-l10n-dev import-xlf --outDir ./l10n ./l10n-xlf",
    "package": "npm run bundle && vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.144.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@vscode/vsce-sign": true
  },
  "overrides": {
    "glob": "^14.0.3"
  }
}
